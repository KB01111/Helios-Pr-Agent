# PR-Agent cloud backend — copy to backend/.env (never commit real secrets)
# backend/main.py auto-loads this file at startup (real process env wins).

# --- GitHub webhook (HMAC verification of X-Hub-Signature-256) ---
# Create at repo Settings -> Webhooks -> Secret, POST to /webhooks/github.
# Empty = dev mode (accepts unsigned webhooks with a warning).
GITHUB_WEBHOOK_SECRET=

# --- API auth (optional Bearer token for agents, runs, quota, config, stream) ---
# Empty = auth disabled (local dev). Set in production to a long random value.
# Only /events/stream additionally accepts ?token= (EventSource cannot set headers).
BACKEND_API_TOKEN=

# --- CORS allowlist, comma-separated (no wildcard default) ---
# The direct EventSource stream needs the desktop webview origin listed here.
ALLOWED_ORIGINS=tauri://localhost,http://tauri.localhost,http://localhost:1420

# --- Calibrated decision layer (idempotent triage, desktop hand-off, escalation) ---
# 0/false/off disables it entirely: every PR event takes the legacy path.
# DECIDER_ENABLED=1
# Seconds the cloud waits for an awake desktop daemon to decide before deciding itself.
# DECIDER_DEFER_GRACE_S=120

# --- Quota (vCPU-seconds per provider per calendar month) ---
# QUOTA_LIMIT=18000

# --- Redis (shared state: agents, runs, debounce, quota) ---
# FastAPI Cloud injects REDIS_URL automatically (redis:// or rediss://).
# When set it takes priority; the Upstash REST settings below still work.
REDIS_URL=

# --- Upstash Redis (shared state: agents, runs, debounce, quota) ---
UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxx

# --- LLM provider for reviews: openrouter (default) | commandcode | opencode_go ---
LLM_PROVIDER=openrouter

# --- LLM via OpenRouter (used by sandbox workers when LLM_PROVIDER=openrouter) ---
OPENROUTER_API_KEY=sk-or-xxx
# Default model for reviews; leave blank to use the provider default
# (OpenRouter: thinkingmachines/inkling-2-small:free,
#  Command Code: openai/deepseek/deepseek-v4-flash, OpenCode Go: openai/kimi-k3).
LLM_MODEL=

# --- Command Code (OpenAI-compatible; use LLM_PROVIDER=commandcode) ---
# Alias accepted: CMD_API_KEY
COMMANDCODE_API_KEY=

# --- OpenCode Go (OpenAI-compatible; use LLM_PROVIDER=opencode_go) ---
# Alias accepted: OPENCODE_API_KEY
# Direct review calls send a stable x-opencode-session header per PR.
OPENCODE_GO_API_KEY=

# --- GitHub token for posting review comments (classic PAT) ---
# Fallback when no GitHub App is configured (or the App is not installed on a repo).
GITHUB_TOKEN=ghp_xxx

# --- GitHub App (recommended: bot identity, Check Runs, all PR events) ---
# Desktop app: Integrations -> "GitHub App" -> Create GitHub App fills these in.
# The backend mints a short-lived installation token per repo (in memory only).
# GITHUB_APP_ID=123456
# GITHUB_APP_SLUG=pr-agent-control
# One line, newlines as literal \n (or use GITHUB_APP_PRIVATE_KEY_PATH=/path/key.pem):
# GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
# The App's own webhook secret; accepted alongside GITHUB_WEBHOOK_SECRET.
# GITHUB_APP_WEBHOOK_SECRET=

# --- Upstash Box sandbox provider ---
UPSTASH_BOX_API_KEY=xxx

# --- Vercel Sandbox provider ---
VERCEL_TOKEN=xxx
# Optional: scope sandbox ops to a team.
# VERCEL_TEAM_ID=team_xxx

# --- Local server ---
PORT=8000
# LOG_LEVEL=INFO
