# PR-Agent cloud backend — copy to backend/.env (never commit real secrets)
# backend/main.py auto-loads this file at startup (real process env wins).

# --- GitHub webhook (HMAC verification of X-Hub-Signature-256) ---
# Create at repo Settings -> Webhooks -> Secret, POST to /webhooks/github.
# Empty = dev mode (accepts unsigned webhooks with a warning).
GITHUB_WEBHOOK_SECRET=

# --- API auth (optional Bearer token for agents, runs, quota, config, stream) ---
# Empty = auth disabled (local dev). Set in production to a long random value.
# Only /events/stream additionally accepts ?token= (EventSource cannot set headers).
BACKEND_API_TOKEN=

# --- CORS allowlist, comma-separated (no wildcard default) ---
# The direct EventSource stream needs the desktop webview origin listed here.
ALLOWED_ORIGINS=tauri://localhost,http://tauri.localhost,http://localhost:1420

# --- Quota (vCPU-seconds per provider per calendar month) ---
# QUOTA_LIMIT=18000

# --- Redis (shared state: agents, runs, debounce, quota) ---
# FastAPI Cloud injects REDIS_URL automatically (redis:// or rediss://).
# When set it takes priority; the Upstash REST settings below still work.
REDIS_URL=

# --- Upstash Redis (shared state: agents, runs, debounce, quota) ---
UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxx

# --- LLM via OpenRouter (used by sandbox workers) ---
OPENROUTER_API_KEY=sk-or-xxx
# Default model for reviews; override per agent if needed.
LLM_MODEL=thinkingmachines/inkling-2-small:free

# --- GitHub token for posting review comments (classic PAT or App token) ---
GITHUB_TOKEN=ghp_xxx

# --- Upstash Box sandbox provider ---
UPSTASH_BOX_API_KEY=xxx

# --- Vercel Sandbox provider ---
VERCEL_TOKEN=xxx
# Optional: scope sandbox ops to a team.
# VERCEL_TEAM_ID=team_xxx

# --- Local server ---
PORT=8000
# LOG_LEVEL=INFO
