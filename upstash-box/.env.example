# Copy to .env (never commit .env). The Tauri app reads these only from
# memory when you paste them into the UI — this file is for CLI use.
UPSTASH_BOX_API_KEY=box_...
OPENROUTER_API_KEY=sk-or-...
GITHUB_TOKEN=ghp_...

# Box auto-runner settings
BOX_NAME=pr-agent-runner
REPOS=owner/repo,owner/other
MODEL=thinkingmachines/inkling-2-small:free
# 5-field UTC cron
PR_CRON=*/15 * * * *
BOX_SIZE=small
